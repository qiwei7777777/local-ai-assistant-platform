APP_NAME=Local AI Assistant Platform
APP_ENV=development
APP_DEBUG=true

APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.250.59.82:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?::3000)?$

DATABASE_URL=sqlite:///./data/local_ai_assistant.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gemma4:e4b
OLLAMA_REQUEST_TIMEOUT=120

CHAT_ENABLE_STREAMING=true
CHAT_DEFAULT_TEMPERATURE=0.7
CHAT_DEFAULT_MAX_TOKENS=1024
CHAT_MAX_CONTEXT_MESSAGES=12

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
MEMORY_TOP_K=3
